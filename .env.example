# ==========================================
# Gemini AI Configuration
# ==========================================
# Required for Gemini AI API calls and autonomous Agent workflows.
# Injected automatically by AI Studio or configured via Secrets panel.
GEMINI_API_KEY=""

# ==========================================
# Application URL
# ==========================================
# The URL where this applet is hosted (injected automatically in Cloud Run).
APP_URL=""

# ==========================================
# Google Cloud & NextAuth OAuth Credentials
# ==========================================
# Optional credentials for custom self-hosted OAuth / NextAuth setups
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# Firebase / Firestore Configuration
# ==========================================
# Standard & Client-accessible Firebase project configuration
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_FIRESTORE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_MEASUREMENT_ID=""
FIREBASE_OAUTH_CLIENT_ID=""
FIREBASE_RECAPTCHA_SITE_KEY=""

# Client-side (Vite / Next.js) public prefixes if deploying custom builds:
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
